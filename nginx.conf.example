# Nginx configuration for Alumni Portal
# Place this in /etc/nginx/sites-available/portal-alumni or similar
# Then symlink to /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name portal-alumni.uol.edu.pk;

    # Increase client body size for large uploads
    client_max_body_size 100M;

    # Increase timeouts for long-running exports
    proxy_connect_timeout 600s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    send_timeout 600s;

    # Buffer settings for large responses
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://localhost:3000;  # Adjust port if your Next.js app runs on different port
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Important: Disable buffering for streaming responses
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Specific configuration for export endpoint with even longer timeout
    location /api/alumni/export {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Extended timeouts for large exports (15 minutes)
        proxy_connect_timeout 900s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        send_timeout 900s;
        
        # Disable buffering for streaming
        proxy_buffering off;
        proxy_request_buffering off;
    }
}


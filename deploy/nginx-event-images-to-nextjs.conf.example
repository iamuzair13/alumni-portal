# Optional nginx in front of PM2 / Next.js (portal-alumni.uol.edu.pk)
#
# Problem: /api/uploads/images/... is proxied to Node, but /images/... is often served as
# "static files" from an empty or build-only directory → 404 for runtime uploads like event-*.jpg
#
# Fix: send ONLY event banner URLs to Next (same process that serves /api/uploads/images).
# Place this block ABOVE any generic `location /images/` or `location /` static root if order matters.
#
# Adjust upstream to your PM2 port or unix socket.

upstream alumni_next {
    server 127.0.0.1:3000;
    # server unix:/path/to/socket.sock;
}

location ~* ^/images/(event-[a-zA-Z0-9\-]+\.(jpg|jpeg|png|gif|webp))$ {
    proxy_pass http://alumni_next;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
